<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/material_dynamic_primary70"
    tools:context=".ControllerActivityButtons">

    <TextView
        android:id="@+id/ipTextViewB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="IP Address"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/ipTextViewB3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BR"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@+id/base_rot_seek"
        app:layout_constraintTop_toTopOf="@+id/base_rot_seek"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/gripper_seek_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grip"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/grip_seek"
        app:layout_constraintStart_toEndOf="@+id/grip_seek"
        app:layout_constraintTop_toTopOf="@+id/grip_seek"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/gripper_seek_textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GR"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/grip_rot_seek"
        app:layout_constraintStart_toEndOf="@+id/grip_rot_seek"
        app:layout_constraintTop_toTopOf="@+id/grip_rot_seek"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="HardcodedText" />

    <SeekBar
        android:id="@+id/speed_seek"
        android:layout_width="270dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:max="255"
        android:progress="255"
        android:progressTint="@color/material_dynamic_primary60"
        android:thumbTint="@color/material_dynamic_primary60"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <SeekBar
        android:id="@+id/base_rot_seek"
        android:layout_width="270dp"
        android:layout_height="30dp"
        android:max="180"
        android:progress="90"
        android:progressTint="@color/material_dynamic_primary60"
        android:thumbTint="@color/material_dynamic_primary60"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintStart_toStartOf="@+id/grip_rot_seek" />

    <SeekBar
        android:id="@+id/grip_rot_seek"
        android:layout_width="270dp"
        android:layout_height="30dp"
        android:max="180"
        android:progress="90"
        android:progressTint="@color/material_dynamic_primary60"
        android:thumbTint="@color/material_dynamic_primary60"
        app:layout_constraintStart_toStartOf="@+id/grip_seek"

        app:layout_constraintTop_toBottomOf="@+id/grip_seek" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/base_rot_seek"
        app:layout_constraintStart_toStartOf="@+id/grip_seek"
        app:layout_constraintTop_toBottomOf="@+id/grip_rot_seek">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/arm_lj_seek"
                android:layout_width="270dp"
                android:layout_height="30dp"
                android:max="90"
                android:progress="0"
                android:progressTint="@color/material_dynamic_primary60"
                android:thumbTint="@color/material_dynamic_primary60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LJ"
                android:textSize="20sp"
                app:layout_constraintVertical_bias="1.0"
                tools:ignore="HardcodedText" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <SeekBar
                android:id="@+id/arm_elb_seek"
                android:layout_width="270dp"
                android:layout_height="30dp"
                android:max="180"
                android:progress="0"
                android:progressTint="@color/material_dynamic_primary60"
                android:thumbTint="@color/material_dynamic_primary60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elb"
                android:textSize="20sp"
                app:layout_constraintVertical_bias="1.0"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <SeekBar
            android:id="@+id/arm_bj_seek"
            android:layout_width="270dp"
            android:layout_height="30dp"
            android:max="180"
            android:progress="0"
            android:progressTint="@color/material_dynamic_primary60"
            android:thumbTint="@color/material_dynamic_primary60" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BJ"
            android:textSize="20sp"
            app:layout_constraintVertical_bias="1.0"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    </LinearLayout>


    <SeekBar
        android:id="@+id/grip_seek"
        android:layout_width="270dp"
        android:layout_height="30dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:max="40"
        android:progress="0"
        android:progressTint="@color/material_dynamic_primary60"
        android:thumbTint="@color/material_dynamic_primary60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ipTextViewB" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/material_dynamic_primary70"
        android:text="@string/speed_hard_coded"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/speed_seek"
        app:layout_constraintEnd_toStartOf="@+id/speed_seek"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_left"
            android:layout_width="130dp"
            android:layout_height="60dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/material_dynamic_primary70"
            app:icon="@drawable/outline_arrow_left_24"
            app:iconGravity="start"
            app:iconSize="40dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_right"
            android:layout_width="130dp"
            android:layout_height="60dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/material_dynamic_primary70"
            app:icon="@drawable/outline_arrow_right_24"
            app:iconGravity="end"
            app:iconSize="40dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            android:layout_width="60dp"
            android:layout_height="130dp"
            android:layout_margin="15dp"
            android:backgroundTint="@color/material_dynamic_primary70"
            app:icon="@drawable/outline_arrow_down_24"
            app:iconGravity="top"
            app:iconSize="40dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_forward"
            android:layout_width="60dp"
            android:layout_height="130dp"
            android:layout_margin="15dp"
            android:backgroundTint="@color/material_dynamic_primary70"
            app:icon="@drawable/outline_arrow_up_24"
            app:iconGravity="top"
            app:iconSize="40dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>